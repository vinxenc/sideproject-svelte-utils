generator client {
  provider = "prisma-client"
  output   = "../src/lib/server/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  media         Media[]
  albums        Album[]
  passwords     Password[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

// Better Auth's rate limiter (rateLimit.storage = 'database'): one row per "<client ip>|<path>".
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

enum MediaKind {
  IMAGE
  VIDEO

  @@map("media_kind")
}

// PENDING: the row exists and presigned upload URLs were issued; READY: the upload was verified.
enum MediaStatus {
  PENDING
  READY

  @@map("media_status")
}

// A photo or video. The bytes live in object storage under `<userId>/<id>/original` and
// `<userId>/<id>/thumb` (see src/lib/server/media.ts).
model Media {
  id          String       @id @default(uuid(7))
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        MediaKind
  status      MediaStatus  @default(PENDING)
  name        String
  contentType String
  // Bytes. Int holds up to 2 GiB, enough for the 1 GB video cap; switch to BigInt if that is raised.
  size        Int
  width       Int?
  height      Int?
  // Seconds, videos only.
  duration    Float?
  // EXIF date taken, or the file's last-modified time.
  takenAt     DateTime
  hasThumb    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  // Soft delete: set instead of removing the row (see src/lib/server/soft-delete.ts).
  deletedAt   DateTime?
  albums      AlbumMedia[]
  coverOf     Album[]      @relation("AlbumCover")

  // The gallery query: one user's READY items, newest first, paged by (takenAt, id).
  @@index([userId, status, takenAt(sort: Desc), id(sort: Desc)])
  @@map("media")
}

model Album {
  id        String       @id @default(uuid(7))
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // Falls back to the album's first-added READY item when unset, or when the cover is deleted or
  // removed from the album.
  coverId   String?
  cover     Media?       @relation("AlbumCover", fields: [coverId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt
  // Soft delete: set instead of removing the row (see src/lib/server/soft-delete.ts).
  deletedAt DateTime?
  media     AlbumMedia[]

  // The album list: one user's albums, most recently changed first, paged by (updatedAt, id).
  @@index([userId, updatedAt(sort: Desc), id(sort: Desc)])
  @@map("album")
}

model AlbumMedia {
  albumId String
  album   Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  mediaId String
  media   Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@id([albumId, mediaId])
  @@index([mediaId])
  @@map("album_media")
}

enum PasswordType {
  APP
  CREDIT_CARD
  API_KEY
  PIN_PLATFORM

  @@map("password_type")
}

// A stored credential. Phase 1 keeps `password` as plain text; phase 2 encrypts it.
// The list never selects it: it is only read by the reveal endpoint.
model Password {
  id        String       @id @default(uuid(7))
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  username  String?
  password  String
  type      PasswordType
  createdAt DateTime     @default(now())
  // Soft delete: set instead of removing the row (see src/lib/server/soft-delete.ts).
  deletedAt DateTime?

  // The list: one user's items, newest first.
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("password")
}
