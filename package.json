{
	"name": "utilities",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview --port 4173 --strictPort",
		"prepare": "svelte-kit sync && prisma generate || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen:icons": "pwa-assets-generator",
		"db-dev:generate": "prisma generate",
		"db-dev:migrate": "prisma migrate dev --url postgresql://utilities:utilities@localhost:5432/utilities",
		"db-dev:studio": "prisma studio --url postgresql://utilities:utilities@localhost:5432/utilities"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.51.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "7.10.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vite-pwa/assets-generator": "^2.0.0",
		"better-auth": "^1.7.7",
		"bits-ui": "^2.18.0",
		"cn": "^0.3.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"prisma": "7.10.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
