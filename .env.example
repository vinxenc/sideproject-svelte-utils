# Local Postgres from docker-compose.yml (`docker compose up -d --wait`).
DATABASE_URL="postgresql://utilities:utilities@localhost:5432/utilities"
# Local-dev only, shared by every checkout/worktree because they share one Docker Postgres
# (its `jwks` key is encrypted with this). Never reuse it outside local development.
BETTER_AUTH_SECRET="LEe4s/TGk1qhwe6/CJxnqsf14FxhtKulCy1+eCocvgg="

# Local RustFS (S3-compatible) from docker-compose.yml; the `media` bucket is created on startup.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="media"
S3_ACCESS_KEY_ID="utilities"
S3_SECRET_ACCESS_KEY="utilities-secret"
